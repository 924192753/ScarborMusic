# =============================================================================
# ScarborMusic — Production Environment (.env.production)
#
# 默认：公网 IP + HTTP（腾讯云 159.75.87.182）
# 复制: cp .env.production.ip.example .env.production
# 或:   cp .env.production.example .env.production
# 部署: ./scripts/deploy-ip.sh
# =============================================================================

# ─── 公网 IP 与 URL（当前生产模式）────────────────────────────────────────────
DOMAIN=159.75.87.182
NEXT_PUBLIC_APP_URL=http://159.75.87.182
COOKIE_SECURE=false

# 若改用域名 + HTTPS，请改为例如：
# DOMAIN=music.example.com
# NEXT_PUBLIC_APP_URL=https://music.example.com
# COOKIE_SECURE=true
# S3_PUBLIC_URL=https://music.example.com/storage
# 并执行 scripts/init-ssl.sh，且 docker compose --profile ssl up -d

# ─── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=scarbormusic
MYSQL_USER=scarbormusic
MYSQL_PASSWORD=change-me-db-password
DATABASE_URL=mysql://scarbormusic:change-me-db-password@mysql:3306/scarbormusic

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# ─── MinIO / S3 ───────────────────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=change-me-minio-access
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=scarbormusic
S3_REGION=us-east-1
S3_PUBLIC_URL=http://159.75.87.182/storage

# ─── SMTP (optional) ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
GRAFANA_ROOT_URL=http://159.75.87.182:3001
GRAFANA_PORT=3001

# ─── Let's Encrypt（仅域名 + HTTPS 时需要）────────────────────────────────────
CERTBOT_EMAIL=

# ─── Backup ───────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=scarbormusic-backups

# ─── Docker images (CI/CD override) ───────────────────────────────────────────
WEB_IMAGE=scarbormusic/web:latest
NGINX_IMAGE=scarbormusic/nginx:latest

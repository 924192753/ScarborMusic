# =============================================================================
# ScarborMusic — Production Environment (.env.production)
# Copy to .env.production on the server and fill in real values.
# =============================================================================

# ─── Domain & URLs ────────────────────────────────────────────────────────────
DOMAIN=music.example.com
NEXT_PUBLIC_APP_URL=https://music.example.com

# IP + HTTP 测试（无 HTTPS）时改为：
# DOMAIN=123.45.67.89
# NEXT_PUBLIC_APP_URL=http://123.45.67.89
# COOKIE_SECURE=false
# 不要执行 scripts/init-ssl.sh

# ─── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=scarbormusic
MYSQL_USER=scarbormusic
MYSQL_PASSWORD=change-me-db-password
DATABASE_URL=mysql://scarbormusic:change-me-db-password@mysql:3306/scarbormusic

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# ─── MinIO / S3 ───────────────────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=change-me-minio-access
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=scarbormusic
S3_REGION=us-east-1
S3_PUBLIC_URL=https://music.example.com/storage

# ─── SMTP (optional) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@music.example.com

# ─── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
GRAFANA_ROOT_URL=http://your-server-ip:3001
GRAFANA_PORT=3001

# ─── Let's Encrypt ────────────────────────────────────────────────────────────
CERTBOT_EMAIL=admin@example.com

# ─── Backup ───────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=scarbormusic-backups

# ─── Docker images (CI/CD override) ───────────────────────────────────────────
WEB_IMAGE=scarbormusic/web:latest
NGINX_IMAGE=scarbormusic/nginx:latest

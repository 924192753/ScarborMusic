// =============================================================================
// ScarborMusic — Prisma Schema
// Database: MySQL 8.4 | Prisma v7
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// =============================================================================
// Role
// =============================================================================

model Role {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique @db.VarChar(32)
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users User[]

  @@index([deletedAt], name: "idx_roles_deleted_at")
  @@map("roles")
}

// =============================================================================
// User
// =============================================================================

model User {
  id                    String    @id @default(uuid()) @db.Char(36)
  username              String    @unique @db.VarChar(32)
  email                 String    @unique @db.VarChar(128)
  passwordHash          String    @map("password_hash") @db.VarChar(255)
  avatarUrl             String?   @map("avatar_url") @db.VarChar(512)
  emailVerified         Boolean   @default(false) @map("email_verified")
  isActive              Boolean   @default(true) @map("is_active")
  roleId                String    @map("role_id") @db.Char(36)
  refreshToken          String?   @map("refresh_token") @db.VarChar(512)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  role          Role           @relation(fields: [roleId], references: [id])
  uploadedFiles UploadedFile[]
  songs         Song[]

  @@index([email], name: "idx_users_email")
  @@index([username], name: "idx_users_username")
  @@index([roleId], name: "idx_users_role_id")
  @@index([deletedAt], name: "idx_users_deleted_at")
  @@index([createdAt(sort: Desc)], name: "idx_users_created_at")
  @@map("users")
}

// =============================================================================
// EmailVerificationCode
// =============================================================================

model EmailVerificationCode {
  id        String   @id @default(uuid()) @db.Char(36)
  email     String   @db.VarChar(128)
  code      String   @db.VarChar(6)
  type      String   @default("register") @db.VarChar(32)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email], name: "idx_email_codes_email")
  @@index([expiresAt], name: "idx_email_codes_expires_at")
  @@map("email_verification_codes")
}

// =============================================================================
// UploadedFile
// =============================================================================

model UploadedFile {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  fileName  String   @map("file_name") @db.VarChar(255)
  objectKey String   @map("object_key") @db.VarChar(512) @unique
  url       String   @db.VarChar(512)
  mimeType  String   @map("mime_type") @db.VarChar(64)
  size      BigInt
  fileType  String   @map("file_type") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  user       User   @relation(fields: [userId], references: [id])
  audioSongs Song[] @relation("SongAudioFile")
  coverSongs Song[] @relation("SongCoverFile")

  @@index([userId], name: "idx_uploaded_files_user_id")
  @@index([fileType], name: "idx_uploaded_files_file_type")
  @@index([createdAt(sort: Desc)], name: "idx_uploaded_files_created_at")
  @@map("uploaded_files")
}

// =============================================================================
// Category
// =============================================================================

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(64)
  slug        String   @unique @db.VarChar(64)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  songs Song[]

  @@map("categories")
}

// =============================================================================
// Tag
// =============================================================================

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(64)
  slug      String   @unique @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  songs SongTag[]

  @@map("tags")
}

// =============================================================================
// Song Status
// =============================================================================

enum SongStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

// =============================================================================
// Song
// =============================================================================

model Song {
  id          String     @id @default(uuid()) @db.Char(36)
  title       String     @db.VarChar(255)
  description String?    @db.Text
  lyrics      String?    @db.LongText
  artistName  String     @map("artist_name") @db.VarChar(255)
  albumName   String?    @map("album_name") @db.VarChar(255)
  // Duration in seconds
  duration    Int?
  playCount   BigInt     @default(0) @map("play_count")
  likeCount   Int        @default(0) @map("like_count")
  status      SongStatus @default(DRAFT)
  audioFileId String?    @map("audio_file_id") @db.Char(36)
  coverFileId String?    @map("cover_file_id") @db.Char(36)
  categoryId  Int?       @map("category_id")
  userId      String     @map("user_id") @db.Char(36)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  audioFile UploadedFile? @relation("SongAudioFile", fields: [audioFileId], references: [id])
  coverFile UploadedFile? @relation("SongCoverFile", fields: [coverFileId], references: [id])
  category  Category?     @relation(fields: [categoryId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
  tags      SongTag[]

  @@index([userId], name: "idx_songs_user_id")
  @@index([categoryId], name: "idx_songs_category_id")
  @@index([status], name: "idx_songs_status")
  @@index([playCount(sort: Desc)], name: "idx_songs_play_count")
  @@index([likeCount(sort: Desc)], name: "idx_songs_like_count")
  @@index([createdAt(sort: Desc)], name: "idx_songs_created_at")
  @@index([deletedAt], name: "idx_songs_deleted_at")
  @@map("songs")
}

// =============================================================================
// SongTag (Many-to-Many)
// =============================================================================

model SongTag {
  songId String @map("song_id") @db.Char(36)
  tagId  Int    @map("tag_id")

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([songId, tagId])
  @@map("song_tags")
}
